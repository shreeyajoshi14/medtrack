# =========================================================
# MEDTRACK — GITIGNORE
# =========================================================

# Environment & Secrets — NEVER commit these
.env
.env.*
!.env.example

# Python compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Local SQLite database (runtime data, not source code)
medtrack.db
*.db
*.sqlite3

# SSH / AWS Key Pairs
*.pem
*.ppk

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Flask instance folder
instance/

# Logs
*.log
logs/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Large unrelated binary/media files
*.docx
*.mp4
*.mp3
*.zip

# Pytest
.pytest_cache/
htmlcov/
.coverage
