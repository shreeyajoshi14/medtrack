# =========================================================
# MEDTRACK ENVIRONMENT TEMPLATE
# Copy this file to .env and configure as needed.
# =========================================================

# Flask Secret Key
FLASK_SECRET_KEY=your-random-secret-key-here

# AWS Region (e.g. us-east-1, ap-south-1)
AWS_REGION=us-east-1

# Persistence Engine
USE_DYNAMODB=true
DYNAMODB_USERS_TABLE=UsersTable
DYNAMODB_APPOINTMENTS_TABLE=AppointmentsTable

# AWS SNS Notifications
ENABLE_SNS=true
SNS_TOPIC_NAME=MedTrack_Notifications
SNS_TOPIC_ARN=

# Optional AWS Credentials (leave empty when using an EC2 IAM Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
